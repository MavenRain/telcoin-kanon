def rec driverResumeTestTake : SubDags -> Nat -> SubDags := fun (dags : SubDags) (count : Nat) =>
  match dags as self in SubDags return SubDags with
  | subDagsNil => subDagsNil
  | subDagsCons head tail => case (natEq count 0) with
    | 1 (unit : prod ()) => subDagsNil
    | 0 (unit : prod ()) => subDagsCons head (driverResumeTestTake tail (natSub count 1))
def rec driverResumeTestStore : ConsensusBlocks -> ConsensusStore -> BatchStore -> sum (Bytes, ConsensusStore) :=
  fun (blocks : ConsensusBlocks) (store : ConsensusStore) (bodies : BatchStore) =>
    match blocks as self in ConsensusBlocks return sum (Bytes, ConsensusStore) with
    | consensusBlocksNil => inj 1 of 2 store
    | consensusBlocksCons block tail => case (consensusRecordCreate block (fun (digest : BatchDigest) => batchStoreFind bodies digest)) with
      | 0 (error : ConsensusRecordError) => inj 0 of 2 (consensusRecordErrorText error)
      | 1 (record : ConsensusRecord) => case (consensusStoreReceive store record) with
        | 0 (error : ConsensusStoreError) => inj 0 of 2 (consensusStoreErrorText error)
        | 1 (next : ConsensusStore) => driverResumeTestStore tail next bodies
def driverResumeTestCheckpointText : Checkpoint -> Bytes := fun (checkpoint : Checkpoint) =>
  let accumulator : ConsensusChain := checkpointAccumulator checkpoint in
  append (consensusBlockNumberText (checkpointWatermark checkpoint)) (append b":"
    (append (consensusBlockNumberText (consensusChainNumber accumulator)) (append b":"
      (append (outputDigestHex (consensusChainParent accumulator)) (append b":"
        (append (decimal64 (epochNat (checkpointEpoch checkpoint))) (append b":" (evmTestBool (checkpointIsSealed checkpoint)))))))))
def driverResumeTestFinish : ChainSpec -> Committee -> Driver -> ConsensusStore -> Epoch -> Nat -> AddressBook -> Bytes :=
  fun (spec : ChainSpec) (supplied : Committee) (initial : Driver) (originalStore : ConsensusStore)
    (storeEpoch : Epoch) (sealed : Nat) (book : AddressBook) =>
    let engine : ExecutionEngine := initial.2 in
    let phase : ExecutionPhase := case (natEq sealed 1) with
      | 0 (unit : prod ()) => engine.6
      | 1 (unit : prod ()) => executionSealed (executionEngineFrontier engine) (executionEngineCommittee engine) in
    let driver : Driver := tuple (initial.0, initial.1, tuple (engine.0,engine.1,engine.2,engine.3,engine.4,engine.5,phase),initial.3) in
    let checkpoint : Checkpoint := driverSnapshot driver in
    let opened : sum (ConsensusStoreError, ConsensusStore) := case (epochEqual storeEpoch (consensusStoreEpoch originalStore)) with
      | 1 (unit : prod ()) => inj 1 of 2 originalStore
      | 0 (unit : prod ()) => consensusStoreOpenEpoch originalStore storeEpoch in
    case opened with
    | 0 (error : ConsensusStoreError) => append b"setup:" (consensusStoreErrorText error)
    | 1 (store : ConsensusStore) =>
      let resumed : Bytes := case (driverResume spec supplied checkpoint store (fun (id : AuthorityId) => addressBookFind book id)) with
        | 0 (error : DriverResumeError) => append b"error:" (driverResumeErrorText error)
        | 1 (outcome : DriverOutcome Driver) => driverPipelineOutcome outcome in
      append (driverResumeTestCheckpointText checkpoint) (append b"~" resumed)
def driverResumeTestRun : ChainSpec -> Committee -> Committee -> Epoch -> SubDags -> Batches -> Nat -> Nat -> Bytes :=
  fun (spec : ChainSpec) (committee : Committee) (supplied : Committee) (storeEpoch : Epoch)
    (dags : SubDags) (batches : Batches) (prefix : Nat) (sealed : Nat) =>
    let initialStore : ConsensusStore := consensusStoreCreate (committeeEpoch committee) consensusBlockNumberGenesis consensusBlockGenesisParent in
    let bodies : BatchStore := batchStoreOfBodies batches in
    let book : AddressBook := addressBookOfCommittee committee in
    case (driverResumeTestStore (executionBlocks dags) initialStore bodies) with
    | 0 (error : Bytes) => append b"setup:" error
    | 1 (store : ConsensusStore) => case (driverFold (driverCreate spec committee) (driverResumeTestTake dags prefix) bodies
        (fun (id : AuthorityId) => addressBookFind book id)) with
      | 0 (advance : prod (Driver, DriverAdvances)) => driverResumeTestFinish spec supplied advance.0 store storeEpoch sealed book
      | 1 (closed : prod (Driver, DriverAdvances, SubDags)) => driverResumeTestFinish spec supplied closed.0 store storeEpoch sealed book
      | 2 (halted : prod (DriverAdvances, DriverError)) => append b"setup:" (driverErrorText halted.1)
def driverTestResume : ByteStrings -> ByteStrings -> Bytes -> Bytes -> Bytes -> Bytes -> Bytes -> Nat -> Nat -> Bytes -> Bytes :=
  fun (members : ByteStrings) (suppliedMembers : ByteStrings) (epochRaw : Bytes) (suppliedEpochRaw : Bytes)
    (storeEpochRaw : Bytes) (dagsRaw : Bytes) (bodiesRaw : Bytes) (prefix : Nat) (sealed : Nat) (registryCode : Bytes) =>
    executionWith Epoch epochCodec epochRaw (fun (epoch : Epoch) =>
    executionWith Epoch epochCodec suppliedEpochRaw (fun (suppliedEpoch : Epoch) =>
    executionWith Epoch epochCodec storeEpochRaw (fun (storeEpoch : Epoch) =>
      match (driverPipelineCommittee members (epochNat epoch)) as first in CommitteeResult return Bytes with
      | committeeError error => append b"setup:" (committeeErrorText error)
      | committeeOk committee => match (driverPipelineCommittee suppliedMembers (epochNat suppliedEpoch)) as second in CommitteeResult return Bytes with
        | committeeError error => append b"setup:" (committeeErrorText error)
        | committeeOk supplied => case (driverPipelineSpec (timestampValue 0) 1000 (hostIntPositive 30000000) registryCode) with
          | 0 (error : ChainSpecError) => append b"setup:" (chainSpecErrorText error)
          | 1 (spec : ChainSpec) =>
            executionWith SubDags (codecList SubDag SubDags seqSubDagOps subDagCodec) dagsRaw (fun (dags : SubDags) =>
            executionWith Batches (codecList Batch Batches seqBatchOps batchCodec) bodiesRaw (fun (bodies : Batches) =>
              driverResumeTestRun spec committee supplied storeEpoch dags bodies prefix sealed)))))

def networkWireRetryVoteRequest : Header -> NetworkCertificates -> NetworkPrimaryRequest :=
  fun (header : Header) (parents : NetworkCertificates) => networkPrimaryReqVote (tuple (header, parents))
def networkWireOutboundOfCommand : Committee -> HostInt -> NodeCommand -> sum (NetworkWireError, NetworkWireOutbounds) :=
  fun (committee : Committee) (chain : HostInt) (command : NodeCommand) =>
    match command as self in NodeCommand return sum (NetworkWireError, NetworkWireOutbounds) with
    | nodeBroadcastHeader header => inj 1 of 2 (listMapInto Authority Authorities NetworkWireOutbound NetworkWireOutbounds seqAuthorityOps seqNetworkWireOutboundOps
        (fun (authority : Authority) => networkWireRequest (authorityId authority) (networkWireRetryVoteRequest header networkCertificatesNil)) (committeeAuthorities committee))
    | nodeSendVote recipient vote => (case (networkVoteWireOfVote vote) with
      | 0 (error : NetworkVoteWireError) => inj 0 of 2 (networkWireVoteIngress error)
      | 1 (wire : NetworkVoteWire) => inj 1 of 2 (networkWireOutboundsCons (networkWireResponse (networkPrimaryResVote wire)) networkWireOutboundsNil))
    | nodeSendMissingParents recipient digests => inj 1 of 2 (networkWireOutboundsCons (networkWireResponse (networkPrimaryResMissingParents digests)) networkWireOutboundsNil)
    | nodeBroadcastCertificate certificate => (case (networkCertificateWireOfCertificate committee certificate) with
      | 0 (error : NetworkCertificateWireError) => inj 0 of 2 (networkWireCertificateIngress error)
      | 1 (wire : NetworkCertificateWire) => inj 1 of 2 (networkWireOutboundsCons (networkWirePublish (networkGossipPrimaryTopic chain)
          (codecWrite NetworkPrimaryGossip networkPrimaryGossipCodec (networkPrimaryGossipCertificate wire))) networkWireOutboundsNil))
    | nodeArmTimer kind generation delay => inj 1 of 2 (networkWireOutboundsCons networkWireLocal networkWireOutboundsNil)
    | nodeEmitCommitted subdag => inj 1 of 2 (networkWireOutboundsCons networkWireLocal networkWireOutboundsNil)
def rec networkWireCheckedParentsAcc : NetworkCertificates -> Committee -> Certificates -> sum (NetworkWireError, Certificates) :=
  fun (parents : NetworkCertificates) (committee : Committee) (out : Certificates) =>
    match parents as self in NetworkCertificates return sum (NetworkWireError, Certificates) with
    | networkCertificatesNil => inj 1 of 2 (seqCertificateReverse out)
    | networkCertificatesCons parent tail => case (networkCertificateWireToChecked committee parent) with
      | 0 (error : NetworkCertificateWireError) => inj 0 of 2 (networkWireCertificateIngress error)
      | 1 (certificate : Certificate) => networkWireCheckedParentsAcc tail committee (certificatesCons certificate out)
def networkWireCheckedParents : Committee -> NetworkCertificates -> sum (NetworkWireError, Certificates) :=
  fun (committee : Committee) (parents : NetworkCertificates) => networkWireCheckedParentsAcc parents committee certificatesNil
def networkWireEventOfRequest : Committee -> AuthorityId -> NetworkPrimaryRequest -> sum (NetworkWireError, NetworkWireInboundVerdict) :=
  fun (committee : Committee) (sender : AuthorityId) (request : NetworkPrimaryRequest) => case request with
    | 0 (vote : prod (Header, NetworkCertificates)) => (case (networkWireCheckedParents committee vote.1) with
      | 0 (error : NetworkWireError) => inj 0 of 2 error
      | 1 (parents : Certificates) => inj 1 of 2 (inj 0 of 2 (nodeVoteRequest sender vote.0 parents)))
    | 1 (peers : NetworkPeerExchange) => inj 1 of 2 (inj 1 of 2 networkWirePeerExchangeRequest)
    | 2 (epoch : prod (ValueOption Epoch, ValueOption Digest)) => inj 1 of 2 (inj 1 of 2 networkWireEpochRecordRequest)
def networkWireEventOfResponse : NetworkPrimaryResponse -> sum (NetworkWireError, NetworkWireInboundVerdict) :=
  fun (response : NetworkPrimaryResponse) => case response with
    | 0 (wire : NetworkVoteWire) => (case (networkVoteWireToVote wire) with
      | 0 (error : NetworkVoteWireError) => inj 0 of 2 (networkWireVoteIngress error)
      | 1 (vote : Vote) => inj 1 of 2 (inj 0 of 2 (nodeVoteReceived vote)))
    | 1 (digests : HeaderDigests) => inj 1 of 2 (inj 1 of 2 networkWireMissingParentsResponse)
    | 2 (epoch : prod (NetworkEpochRecord, NetworkEpochCertificate)) => inj 1 of 2 (inj 1 of 2 networkWireEpochRecordResponse)
    | 3 (peers : NetworkPeerExchange) => inj 1 of 2 (inj 1 of 2 networkWirePeerExchangeResponse)
    | 4 (error : Bytes) => inj 1 of 2 (inj 1 of 2 networkWireRpcErrorResponse)
    | 5 (error : Bytes) => inj 1 of 2 (inj 1 of 2 networkWireRecoverableRpcErrorResponse)
def networkWireVerdictOfPayload : Committee -> NetworkGossipPayload -> sum (NetworkWireError, NetworkWireInboundVerdict) :=
  fun (committee : Committee) (payload : NetworkGossipPayload) => case payload with
    | 1 (worker : NetworkWorkerGossip) => inj 1 of 2 (inj 1 of 2 networkWireWorkerBatchGossip)
    | 0 (primary : NetworkPrimaryGossip) => case primary with
      | 0 (wire : NetworkCertificateWire) => (case (networkCertificateWireToChecked committee wire) with
        | 0 (error : NetworkCertificateWireError) => inj 0 of 2 (networkWireCertificateIngress error)
        | 1 (certificate : Certificate) => inj 1 of 2 (inj 0 of 2 (nodeCertificateReceived certificate)))
      | 1 (consensus : NetworkConsensusResult) => inj 1 of 2 (inj 1 of 2 networkWireConsensusGossip)
      | 2 (epochVote : NetworkEpochVote) => inj 1 of 2 (inj 1 of 2 networkWireEpochVoteGossip)
def networkWireEventOfGossip : Committee -> HostInt -> Bytes -> Bytes -> sum (NetworkWireError, NetworkWireInboundVerdict) :=
  fun (committee : Committee) (chain : HostInt) (topic : Bytes) (bytes : Bytes) => case (networkGossipDecode chain topic bytes) with
    | 0 (error : NetworkGossipError) => inj 0 of 2 (networkWireGossipDecode error)
    | 1 (payload : NetworkGossipPayload) => networkWireVerdictOfPayload committee payload

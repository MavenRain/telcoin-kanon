mu IntentScope : Type 0 :=
| intentConsensusVote : IntentScope
def intentPrefix : IntentScope -> Bytes := fun (scope : IntentScope) =>
  match scope as self in IntentScope return Bytes with
  | intentConsensusVote => b"\x02\x00\x01"
def intentWrap : IntentScope -> Bytes -> Bytes := fun (scope : IntentScope) (message : Bytes) => append (intentPrefix scope) message
def voteSigningMessage : HeaderDigest -> Bytes := fun (digest : HeaderDigest) =>
  intentWrap intentConsensusVote (bcsEncodeBytes (headerDigestBytes digest))
mu Vote : Type 0 :=
| voteValue (digest : HeaderDigest) (round : Round) (epoch : Epoch) (origin : AuthorityId) (author : AuthorityId) (signature : Signature) : Vote
def voteFields : Vote -> prod (HeaderDigest, Round, Epoch, AuthorityId, AuthorityId, Signature) := fun (vote : Vote) =>
  match vote as self in Vote return prod (HeaderDigest, Round, Epoch, AuthorityId, AuthorityId, Signature) with
  | voteValue digest round epoch origin author signature => tuple (digest, round, epoch, origin, author, signature)
def voteHeaderDigest : Vote -> HeaderDigest := fun (vote : Vote) => (voteFields vote).0
def voteRound : Vote -> Round := fun (vote : Vote) => (voteFields vote).1
def voteEpoch : Vote -> Epoch := fun (vote : Vote) => (voteFields vote).2
def voteOrigin : Vote -> AuthorityId := fun (vote : Vote) => (voteFields vote).3
def voteAuthor : Vote -> AuthorityId := fun (vote : Vote) => (voteFields vote).4
def voteSignature : Vote -> Signature := fun (vote : Vote) => (voteFields vote).5
def voteSign : SecretKey -> AuthorityId -> Header -> Vote := fun (secret : SecretKey) (voter : AuthorityId) (header : Header) =>
  voteValue (headerDigest header) (headerRound header) (headerEpoch header) (headerAuthor header) voter
    (cryptoSign secret (voteSigningMessage (headerDigest header)))
def voteClaim : HeaderDigest -> Round -> Epoch -> AuthorityId -> AuthorityId -> Bytes -> ValueOption Vote :=
  fun (digest : HeaderDigest) (round : Round) (epoch : Epoch) (origin : AuthorityId) (author : AuthorityId) (bytes : Bytes) =>
    case (signatureOfBytes bytes) with
    | 0 (unit : prod ()) => valueNone Vote
    | 1 (signature : Signature) => valueSome Vote (voteValue digest round epoch origin author signature)
def voteVerify : PublicKey -> Vote -> Bool := fun (key : PublicKey) (vote : Vote) => cryptoVerify key (voteSigningMessage (voteHeaderDigest vote)) (voteSignature vote)

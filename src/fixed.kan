mu Address : Type 0 :=
| addressValue (bytes : Bytes) : Address
def addressBytes : Address -> Bytes := fun (value : Address) =>
  match value as self in Address return Bytes with
  | addressValue bytes => bytes
def addressOfBytes : Bytes -> ValueOption Address := fun (bytes : Bytes) =>
  case (natEq (natMul (boolNat (natEq (bytesLength bytes) 20)) (bytesValid bytes)) 1) with
  | 0 (unit : prod ()) => valueNone Address
  | 1 (unit : prod ()) => valueSome Address (addressValue bytes)
def addressZero : Address := addressValue b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
def addressEqual : Address -> Address -> Bool := fun (a : Address) (b : Address) => bytesEqual (addressBytes a) (addressBytes b)
def addressCompare : Address -> Address -> Ordering := fun (a : Address) (b : Address) => bytesOrdering (addressBytes a) (addressBytes b)
def addressHex : Address -> Bytes := fun (value : Address) => bytesHex (addressBytes value)
def addressCodec : Codec Address := codecRefine Bytes Address addressOfBytes addressBytes (codecSizedBytes 20)

mu HeaderDigest : Type 0 :=
| headerDigestValue (bytes : Bytes) : HeaderDigest
def headerDigestBytes : HeaderDigest -> Bytes := fun (value : HeaderDigest) =>
  match value as self in HeaderDigest return Bytes with
  | headerDigestValue bytes => bytes
def headerDigestOfBytes : Bytes -> ValueOption HeaderDigest := fun (bytes : Bytes) =>
  case (natEq (natMul (boolNat (natEq (bytesLength bytes) 32)) (bytesValid bytes)) 1) with
  | 0 (unit : prod ()) => valueNone HeaderDigest
  | 1 (unit : prod ()) => valueSome HeaderDigest (headerDigestValue bytes)
def headerDigestZero : HeaderDigest := headerDigestValue b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
def headerDigestEqual : HeaderDigest -> HeaderDigest -> Bool := fun (a : HeaderDigest) (b : HeaderDigest) => bytesEqual (headerDigestBytes a) (headerDigestBytes b)
def headerDigestCompare : HeaderDigest -> HeaderDigest -> Ordering := fun (a : HeaderDigest) (b : HeaderDigest) => bytesOrdering (headerDigestBytes a) (headerDigestBytes b)
def headerDigestHex : HeaderDigest -> Bytes := fun (value : HeaderDigest) => bytesHex (headerDigestBytes value)
def headerDigestCodec : Codec HeaderDigest := codecRefine Bytes HeaderDigest headerDigestOfBytes headerDigestBytes (codecSizedBytes 32)
def headerDigestOfDigest : Digest -> HeaderDigest := fun (value : Digest) => headerDigestValue (digestBytes value)
def headerDigestToDigest : HeaderDigest -> Digest := fun (value : HeaderDigest) => digestValue (headerDigestBytes value)


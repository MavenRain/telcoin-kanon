-- Fixed-width protocol values. Smart constructors validate octets and width.
def bytesEqual : Bytes -> Bytes -> Bool := fun (a : Bytes) (b : Bytes) =>
  match (bytesOrdering a b) as self in Ordering return Bool with
  | orderLess => natEq 0 1
  | orderEqual => natEq 0 0
  | orderGreater => natEq 0 1
def rec bytesHexAcc : Bytes -> Bytes -> Bytes := fun (input : Bytes) (acc : Bytes) =>
  match input as self in Bytes return Bytes with
  | bytesNil => reverse acc
  | bytesCons head tail => bytesHexAcc tail (reverseOnto (bcsHexByte head) acc)
def bytesHex : Bytes -> Bytes := fun (input : Bytes) => bytesHexAcc input bytesNil

mu Digest : Type 0 :=
| digestValue (bytes : Bytes) : Digest
def digestBytes : Digest -> Bytes := fun (value : Digest) =>
  match value as self in Digest return Bytes with
  | digestValue bytes => bytes
def digestOfBytes : Bytes -> ValueOption Digest := fun (bytes : Bytes) =>
  case (natEq (natMul (boolNat (natEq (bytesLength bytes) 32)) (bytesValid bytes)) 1) with
  | 0 (unit : prod ()) => valueNone Digest
  | 1 (unit : prod ()) => valueSome Digest (digestValue bytes)
def digestZero : Digest := digestValue b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
def digestEqual : Digest -> Digest -> Bool := fun (a : Digest) (b : Digest) => bytesEqual (digestBytes a) (digestBytes b)
def digestCompare : Digest -> Digest -> Ordering := fun (a : Digest) (b : Digest) => bytesOrdering (digestBytes a) (digestBytes b)
def digestHex : Digest -> Bytes := fun (value : Digest) => bytesHex (digestBytes value)
def digestCodec : Codec Digest := codecRefine Bytes Digest digestOfBytes digestBytes (codecSizedBytes 32)

mu Hash32 : Type 0 :=
| hash32Value (bytes : Bytes) : Hash32
def hash32Bytes : Hash32 -> Bytes := fun (value : Hash32) =>
  match value as self in Hash32 return Bytes with
  | hash32Value bytes => bytes
def hash32OfBytes : Bytes -> ValueOption Hash32 := fun (bytes : Bytes) =>
  case (natEq (natMul (boolNat (natEq (bytesLength bytes) 32)) (bytesValid bytes)) 1) with
  | 0 (unit : prod ()) => valueNone Hash32
  | 1 (unit : prod ()) => valueSome Hash32 (hash32Value bytes)
def hash32Zero : Hash32 := hash32Value b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
def hash32Equal : Hash32 -> Hash32 -> Bool := fun (a : Hash32) (b : Hash32) => bytesEqual (hash32Bytes a) (hash32Bytes b)
def hash32Compare : Hash32 -> Hash32 -> Ordering := fun (a : Hash32) (b : Hash32) => bytesOrdering (hash32Bytes a) (hash32Bytes b)
def hash32Hex : Hash32 -> Bytes := fun (value : Hash32) => bytesHex (hash32Bytes value)
def hash32Codec : Codec Hash32 := codecRefine Bytes Hash32 hash32OfBytes hash32Bytes (codecSizedBytes 32)


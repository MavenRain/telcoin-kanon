  fun (compare : Nats -> Nats -> Ordering) (xs : NatLists) => seqNatListUniqScan xs compare (valueNone (Nats)) natListsNil
def seqNatListOps : ListOps (Nats) NatLists :=
  tuple (seqNatListEmpty, seqNatListCons, seqNatListReverse, seqNatListLength, seqNatListHead, seqNatListTail, seqNatListWrite, seqNatListSort, seqNatListUniq)

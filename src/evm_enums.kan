def topicCountAll : TopicCounts := topicCountsCons topicZero (topicCountsCons topicOne (topicCountsCons topicTwo (topicCountsCons topicThree (topicCountsCons topicFour (topicCountsNil)))))
def opcodeDecodeHostInt : HostInt -> ValueOption Opcode := fun (value : HostInt) => match value as self in HostInt return ValueOption Opcode with
  | hostIntNegative n => valueNone Opcode | hostIntPositive n => opcodeDecode n

def roundGenesis : Round := roundValue 0
def roundSucc : Round -> Round := fun (value : Round) => roundValue (minNat u32Max (natAdd (roundNat value) 1))
def roundPred : Round -> RoundResult := fun (value : Round) =>
  case (natEq (roundNat value) 0) with
  | 0 (unit : prod ()) => roundOfNat (natSub (roundNat value) 1)
  | 1 (unit : prod ()) => roundInvalid
def roundSub : Round -> Nat -> Round := fun (value : Round) (amount : Nat) => roundValue (natSub (roundNat value) amount)
def roundParity : Round -> Nat := fun (value : Round) => remainder64 (roundNat value) 2
def epochSucc : Epoch -> Epoch := fun (value : Epoch) => epochValue (minNat u32Max (natAdd (epochNat value) 1))
def timestampAdd : Timestamp -> Nat -> Timestamp := fun (value : Timestamp) (seconds : Nat) =>
  timestampValue (minNat timestampMax (natAdd (timestampNat value) seconds))
def timestampLater : Timestamp -> Timestamp -> Timestamp := fun (a : Timestamp) (b : Timestamp) =>
  timestampValue (maxNat (timestampNat a) (timestampNat b))
def durationHalf : Duration -> Duration := fun (value : Duration) => durationValue (quotient64 (durationNat value) 2)
def baseFeeMinimum : BaseFee := baseFeeValue 7
-- Checked results replace the source's host-int overflow for these two sums.
def stakeAdd : Stake -> Stake -> StakeResult := fun (a : Stake) (b : Stake) => stakeOfNat (natAdd (stakeNat a) (stakeNat b))
def durationAdd : Duration -> Duration -> DurationResult := fun (a : Duration) (b : Duration) => durationOfNat (natAdd (durationNat a) (durationNat b))

mu LeaderRound : Type 0 :=
| leaderRoundValue (round : Round) : LeaderRound
mu LeaderRoundResult : Type 0 :=
| leaderRoundInvalid : LeaderRoundResult
| leaderRoundValid (value : LeaderRound) : LeaderRoundResult
def leaderRoundOfRound : Round -> LeaderRoundResult := fun (value : Round) =>
  let invalid : Nat := maxNat (boolNat (natLt (roundNat value) 2)) (roundParity value) in
  case (natEq invalid 0) with
  | 0 (unit : prod ()) => leaderRoundInvalid
  | 1 (unit : prod ()) => leaderRoundValid (leaderRoundValue value)
def leaderRoundRound : LeaderRound -> Round := fun (value : LeaderRound) =>
  match value as self in LeaderRound return Round with
  | leaderRoundValue round => round
def leaderRoundIndex : LeaderRound -> Nat := fun (value : LeaderRound) =>
  natSub (quotient64 (roundNat (leaderRoundRound value)) 2) 1
def leaderRoundNext : LeaderRound -> LeaderRoundResult := fun (value : LeaderRound) =>
  match (roundOfNat (natAdd (roundNat (leaderRoundRound value)) 2)) as self in RoundResult return LeaderRoundResult with
  | roundInvalid => leaderRoundInvalid
  | roundValid next => leaderRoundOfRound next
def leaderRoundPrev : LeaderRound -> LeaderRoundResult := fun (value : LeaderRound) =>
  leaderRoundOfRound (roundSub (leaderRoundRound value) 2)
def leaderRoundParse : Bytes -> LeaderRoundResult := fun (text : Bytes) =>
  match (roundParse text) as self in RoundResult return LeaderRoundResult with
  | roundInvalid => leaderRoundInvalid
  | roundValid value => leaderRoundOfRound value
def leaderRoundText : LeaderRoundResult -> Bytes := fun (result : LeaderRoundResult) =>
  match result as self in LeaderRoundResult return Bytes with
  | leaderRoundInvalid => b"none"
  | leaderRoundValid value => decimal64 (roundNat (leaderRoundRound value))
mu SequenceNumber : Type 0 :=
| sequenceNumber (epoch : Epoch) (round : Round) : SequenceNumber
def sequenceBits : SequenceNumber -> Nat := fun (value : SequenceNumber) =>
  match value as self in SequenceNumber return Nat with
  | sequenceNumber epoch round => natAdd (natMul (epochNat epoch) 4294967296) (roundNat round)
def sequenceEpoch : SequenceNumber -> Epoch := fun (value : SequenceNumber) =>
  match value as self in SequenceNumber return Epoch with
  | sequenceNumber epoch round => epoch
def sequenceRound : SequenceNumber -> Round := fun (value : SequenceNumber) =>
  match value as self in SequenceNumber return Round with
  | sequenceNumber epoch round => round
-- OCaml compares the packed int64 as signed; preserve that ordering.
def sequenceLess : SequenceNumber -> SequenceNumber -> Nat := fun (a : SequenceNumber) (b : SequenceNumber) =>
  let av : Nat := sequenceBits a in
  let bv : Nat := sequenceBits b in
  let aPositive : Nat := boolNat (natLt av 9223372036854775808) in
  let bPositive : Nat := boolNat (natLt bv 9223372036854775808) in
  case (natEq aPositive bPositive) with
  | 0 (unit : prod ()) => bPositive
  | 1 (unit : prod ()) => boolNat (natLt av bv)

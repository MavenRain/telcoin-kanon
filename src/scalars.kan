-- Nominal protocol scalars. Construction is checked; the source language has no private declarations.

mu Round : Type 0 :=
| roundValue (value : Nat) : Round
mu RoundResult : Type 0 :=
| roundInvalid : RoundResult
| roundValid (value : Round) : RoundResult
def roundNat : Round -> Nat := fun (value : Round) =>
  match value as self in Round return Nat with
  | roundValue n => n
def roundOfNat : Nat -> RoundResult := fun (n : Nat) =>
  case (natLt u32Max n) with
  | 0 (unit : prod ()) => roundValid (roundValue n)
  | 1 (unit : prod ()) => roundInvalid
def roundParse : Bytes -> RoundResult := fun (text : Bytes) =>
  match (parseU64 text) as self in NatOption return RoundResult with
  | natNone => roundInvalid
  | natSome n => roundOfNat n
def roundText : RoundResult -> Bytes := fun (result : RoundResult) =>
  match result as self in RoundResult return Bytes with
  | roundInvalid => b"none"
  | roundValid value => decimal64 (roundNat value)


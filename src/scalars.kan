mu BaseFee : Type 0 :=
| baseFeeValue (value : Nat) : BaseFee
mu BaseFeeResult : Type 0 :=
| baseFeeInvalid : BaseFeeResult
| baseFeeValid (value : BaseFee) : BaseFeeResult
def baseFeeNat : BaseFee -> Nat := fun (value : BaseFee) =>
  match value as self in BaseFee return Nat with
  | baseFeeValue n => n
def baseFeeOfNat : Nat -> BaseFeeResult := fun (n : Nat) =>
  case (natLt u64Max n) with
  | 0 (unit : prod ()) => baseFeeValid (baseFeeValue n)
  | 1 (unit : prod ()) => baseFeeInvalid
def baseFeeParse : Bytes -> BaseFeeResult := fun (text : Bytes) =>
  match (parseU64 text) as self in NatOption return BaseFeeResult with
  | natNone => baseFeeInvalid
  | natSome n => baseFeeOfNat n

def ripemdInitial : Ripemd5 := tuple (1732584193, 4023233417, 2562383102, 271733878, 3285377520)
def ripemdLeftIndex : Nats := natsCons 0 (natsCons 1 (natsCons 2 (natsCons 3 (natsCons 4 (natsCons 5 (natsCons 6 (natsCons 7 (natsCons 8 (natsCons 9 (natsCons 10 (natsCons 11 (natsCons 12 (natsCons 13 (natsCons 14 (natsCons 15 (natsCons 7 (natsCons 4 (natsCons 13 (natsCons 1 (natsCons 10 (natsCons 6 (natsCons 15 (natsCons 3 (natsCons 12 (natsCons 0 (natsCons 9 (natsCons 5 (natsCons 2 (natsCons 14 (natsCons 11 (natsCons 8 (natsCons 3 (natsCons 10 (natsCons 14 (natsCons 4 (natsCons 9 (natsCons 15 (natsCons 8 (natsCons 1 (natsCons 2 (natsCons 7 (natsCons 0 (natsCons 6 (natsCons 13 (natsCons 11 (natsCons 5 (natsCons 12 (natsCons 1 (natsCons 9 (natsCons 11 (natsCons 10 (natsCons 0 (natsCons 8 (natsCons 12 (natsCons 4 (natsCons 13 (natsCons 3 (natsCons 7 (natsCons 15 (natsCons 14 (natsCons 5 (natsCons 6 (natsCons 2 (natsCons 4 (natsCons 0 (natsCons 5 (natsCons 9 (natsCons 7 (natsCons 12 (natsCons 2 (natsCons 10 (natsCons 14 (natsCons 1 (natsCons 3 (natsCons 8 (natsCons 11 (natsCons 6 (natsCons 15 (natsCons 13 (natsNil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

-- BLAKE2b compression lanes and message permutations from the pinned OCaml source.
def blake2bG : prod (Nat, Nat, Nat, Nat) -> Nat -> Nat -> prod (Nat, Nat, Nat, Nat) :=
  fun (lane : prod (Nat, Nat, Nat, Nat)) (x : Nat) (y : Nat) =>
    let a : Nat := wordAdd64 (wordAdd64 lane.0 lane.1) x in
    let d : Nat := wordRotate64 (wordXor64 lane.3 a) 4294967296 4294967296 in
    let c : Nat := wordAdd64 lane.2 d in
    let b : Nat := wordRotate64 (wordXor64 lane.1 c) 16777216 1099511627776 in
    let aa : Nat := wordAdd64 (wordAdd64 a b) y in
    let dd : Nat := wordRotate64 (wordXor64 d aa) 65536 281474976710656 in
    let cc : Nat := wordAdd64 c dd in
    let bb : Nat := wordRotate64 (wordXor64 b cc) 9223372036854775808 2 in
    tuple (aa, bb, cc, dd)
def blake2bStep0 : Blake16 -> Nat -> Nat -> Blake16 := fun (state : Blake16) (x : Nat) (y : Nat) =>
  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.0, state.4, state.8, state.12)) x y in
  tuple (changed.0, state.1, state.2, state.3, changed.1, state.5, state.6, state.7, changed.2, state.9, state.10, state.11, changed.3, state.13, state.14, state.15)
def blake2bStep1 : Blake16 -> Nat -> Nat -> Blake16 := fun (state : Blake16) (x : Nat) (y : Nat) =>
  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.1, state.5, state.9, state.13)) x y in
  tuple (state.0, changed.0, state.2, state.3, state.4, changed.1, state.6, state.7, state.8, changed.2, state.10, state.11, state.12, changed.3, state.14, state.15)
def blake2bStep2 : Blake16 -> Nat -> Nat -> Blake16 := fun (state : Blake16) (x : Nat) (y : Nat) =>
  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.2, state.6, state.10, state.14)) x y in
  tuple (state.0, state.1, changed.0, state.3, state.4, state.5, changed.1, state.7, state.8, state.9, changed.2, state.11, state.12, state.13, changed.3, state.15)

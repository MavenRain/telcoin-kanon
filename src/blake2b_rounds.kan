def blake2bRound : Nat -> Blake16 -> Blake16 -> Blake16 := fun (index : Nat) (message : Blake16) (state : Blake16) =>
  case (natEq index 0) with | 1 (unit : prod ()) => blake2bRound0 message state | 0 (unit : prod ()) =>
  case (natEq index 1) with | 1 (unit : prod ()) => blake2bRound1 message state | 0 (unit : prod ()) =>
  case (natEq index 2) with | 1 (unit : prod ()) => blake2bRound2 message state | 0 (unit : prod ()) =>
  case (natEq index 3) with | 1 (unit : prod ()) => blake2bRound3 message state | 0 (unit : prod ()) =>
  case (natEq index 4) with | 1 (unit : prod ()) => blake2bRound4 message state | 0 (unit : prod ()) =>
  case (natEq index 5) with | 1 (unit : prod ()) => blake2bRound5 message state | 0 (unit : prod ()) =>
  case (natEq index 6) with | 1 (unit : prod ()) => blake2bRound6 message state | 0 (unit : prod ()) =>
  case (natEq index 7) with | 1 (unit : prod ()) => blake2bRound7 message state | 0 (unit : prod ()) =>
  case (natEq index 8) with | 1 (unit : prod ()) => blake2bRound8 message state | 0 (unit : prod ()) =>
  blake2bRound9 message state

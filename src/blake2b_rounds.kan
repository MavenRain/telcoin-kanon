  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.1, state.6, state.11, state.12)) x y in
  tuple (state.0, changed.0, state.2, state.3, state.4, state.5, changed.1, state.7, state.8, state.9, state.10, changed.2, changed.3, state.13, state.14, state.15)
def blake2bStep6 : Blake16 -> Nat -> Nat -> Blake16 := fun (state : Blake16) (x : Nat) (y : Nat) =>
  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.2, state.7, state.8, state.13)) x y in
  tuple (state.0, state.1, changed.0, state.3, state.4, state.5, state.6, changed.1, changed.2, state.9, state.10, state.11, state.12, changed.3, state.14, state.15)
def blake2bStep7 : Blake16 -> Nat -> Nat -> Blake16 := fun (state : Blake16) (x : Nat) (y : Nat) =>
  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.3, state.4, state.9, state.14)) x y in
  tuple (state.0, state.1, state.2, changed.0, changed.1, state.5, state.6, state.7, state.8, changed.2, state.10, state.11, state.12, state.13, changed.3, state.15)
def blake2bRound0 : Blake16 -> Blake16 -> Blake16 := fun (message : Blake16) (initial : Blake16) =>
  let s0 : Blake16 := blake2bStep0 initial message.0 message.1 in
  let s1 : Blake16 := blake2bStep1 s0 message.2 message.3 in
  let s2 : Blake16 := blake2bStep2 s1 message.4 message.5 in
  let s3 : Blake16 := blake2bStep3 s2 message.6 message.7 in
  let s4 : Blake16 := blake2bStep4 s3 message.8 message.9 in
  let s5 : Blake16 := blake2bStep5 s4 message.10 message.11 in
  let s6 : Blake16 := blake2bStep6 s5 message.12 message.13 in
  let s7 : Blake16 := blake2bStep7 s6 message.14 message.15 in
  s7

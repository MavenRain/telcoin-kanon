  tuple (state.0, state.1, state.2, changed.0, state.4, state.5, state.6, changed.1, state.8, state.9, state.10, changed.2, state.12, state.13, state.14, changed.3)
def blake2bStep4 : Blake16 -> Nat -> Nat -> Blake16 := fun (state : Blake16) (x : Nat) (y : Nat) =>
  let changed : prod (Nat, Nat, Nat, Nat) := blake2bG (tuple (state.0, state.5, state.10, state.15)) x y in
  tuple (changed.0, state.1, state.2, state.3, state.4, changed.1, state.6, state.7, state.8, state.9, changed.2, state.11, state.12, state.13, state.14, changed.3)

def EvmBlock : Type 0 := prod (EvmSpec, Address, U256, U256, U256, U256, U256, Address, U256, U256, BlockHashes)
def evmBlockMakeAtSpec : EvmSpec -> Address -> U256 -> U256 -> U256 -> U256 -> U256 -> Address -> U256 -> U256 -> BlockHashes -> EvmBlock :=
  fun (spec : EvmSpec) (coinbase : Address) (timestamp : U256) (number : U256) (prevrandao : U256) (gasLimit : U256) (basefee : U256)
    (basefeeAddress : Address) (chainId : U256) (blobGasprice : U256) (hashes : BlockHashes) =>
    tuple (spec, coinbase, timestamp, number, prevrandao, gasLimit, basefee, basefeeAddress, chainId, blobGasprice, hashes)
def evmBlockMake : Address -> U256 -> U256 -> U256 -> U256 -> U256 -> Address -> U256 -> U256 -> BlockHashes -> EvmBlock := evmBlockMakeAtSpec evmPrague
def evmBlockSpec : EvmBlock -> EvmSpec := fun (block : EvmBlock) => block.0
def evmBlockCoinbase : EvmBlock -> Address := fun (block : EvmBlock) => block.1
def evmBlockTimestamp : EvmBlock -> U256 := fun (block : EvmBlock) => block.2
def evmBlockNumber : EvmBlock -> U256 := fun (block : EvmBlock) => block.3
def evmBlockPrevrandao : EvmBlock -> U256 := fun (block : EvmBlock) => block.4
def evmBlockGasLimit : EvmBlock -> U256 := fun (block : EvmBlock) => block.5
def evmBlockBasefee : EvmBlock -> U256 := fun (block : EvmBlock) => block.6
def evmBlockBasefeeAddress : EvmBlock -> Address := fun (block : EvmBlock) => block.7
def evmBlockChainId : EvmBlock -> U256 := fun (block : EvmBlock) => block.8
def evmBlockBlobGasprice : EvmBlock -> U256 := fun (block : EvmBlock) => block.9
def evmBlockHashes : EvmBlock -> BlockHashes := fun (block : EvmBlock) => block.10
def evmConsensusBlobGasprice : U256 := u256Value 340282366920938463463374607431768211455
def evmBlockEqual : EvmBlock -> EvmBlock -> Bool := fun (a : EvmBlock) (b : EvmBlock) =>
  boolAnd (orderingEqual (evmSpecCompare a.0 b.0)) (boolAnd (addressEqual a.1 b.1) (boolAnd (u256Equal a.2 b.2)
    (boolAnd (u256Equal a.3 b.3) (boolAnd (u256Equal a.4 b.4) (boolAnd (u256Equal a.5 b.5) (boolAnd (u256Equal a.6 b.6)
      (boolAnd (addressEqual a.7 b.7) (boolAnd (u256Equal a.8 b.8) (boolAnd (u256Equal a.9 b.9) (blockHashesEqual a.10 b.10))))))))))
def EvmTx : Type 0 := prod (Address, U256, TxAccessEntries)
def evmTxMake : Address -> U256 -> TxAccessEntries -> EvmTx := fun (origin : Address) (gasPrice : U256) (accessList : TxAccessEntries) => tuple (origin, gasPrice, accessList)
def evmTxOrigin : EvmTx -> Address := fun (tx : EvmTx) => tx.0
def evmTxGasprice : EvmTx -> U256 := fun (tx : EvmTx) => tx.1
def evmTxAccessList : EvmTx -> TxAccessEntries := fun (tx : EvmTx) => tx.2
def txAccessEntryCompare : prod (Address, Words) -> prod (Address, Words) -> Ordering := fun (a : prod (Address, Words)) (b : prod (Address, Words)) =>
  let address : Ordering := addressCompare a.0 b.0 in case (orderingEqual address) with | 0 (unit : prod ()) => address
  | 1 (unit : prod ()) => listCompare U256 Words seqWordOps u256Compare a.1 b.1
def evmTxEqual : EvmTx -> EvmTx -> Bool := fun (a : EvmTx) (b : EvmTx) => boolAnd (addressEqual a.0 b.0)
  (boolAnd (u256Equal a.1 b.1) (orderingEqual (listCompare (prod (Address, Words)) TxAccessEntries seqTxAccessEntryOps txAccessEntryCompare a.2 b.2)))
def evmTxDeclaredWarm : EvmTx -> prod (Addresses, AddressSlots) := fun (tx : EvmTx) =>
  let reversed : prod (Addresses, AddressSlots) := listFoldLeft (prod (Address, Words)) TxAccessEntries (prod (Addresses, AddressSlots)) seqTxAccessEntryOps
    (fun (state : prod (Addresses, AddressSlots)) (entry : prod (Address, Words)) => tuple (addressesCons entry.0 state.0,
      listFoldLeft U256 Words AddressSlots seqWordOps (fun (slots : AddressSlots) (word : U256) => addressSlotsCons (tuple (entry.0, word)) slots) state.1 entry.1))
    (tuple (addressesNil, addressSlotsNil)) tx.2 in tuple (seqAddressReverse reversed.0, seqAddressSlotReverse reversed.1)
def EvmCall : Type 0 := prod (Address, Address, U256, EvmData, Mutability)
def evmCallMake : Address -> Address -> U256 -> EvmData -> Mutability -> EvmCall := fun (target : Address) (caller : Address) (value : U256) (data : EvmData) (mode : Mutability) => tuple (target, caller, value, data, mode)
def evmCallTarget : EvmCall -> Address := fun (call : EvmCall) => call.0
def evmCallCaller : EvmCall -> Address := fun (call : EvmCall) => call.1
def evmCallValue : EvmCall -> U256 := fun (call : EvmCall) => call.2
def evmCallData : EvmCall -> EvmData := fun (call : EvmCall) => call.3
def evmCallMutability : EvmCall -> Mutability := fun (call : EvmCall) => call.4
def evmCallEqual : EvmCall -> EvmCall -> Bool := fun (a : EvmCall) (b : EvmCall) => boolAnd (addressEqual a.0 b.0)
  (boolAnd (addressEqual a.1 b.1) (boolAnd (u256Equal a.2 b.2) (boolAnd (evmDataEqual a.3 b.3) (mutabilityEqual a.4 b.4))))
def EvmEnv : Type 0 := prod (EvmBlock, EvmTx, EvmCall)
def evmEnvMake : EvmBlock -> EvmTx -> EvmCall -> EvmEnv := fun (block : EvmBlock) (tx : EvmTx) (call : EvmCall) => tuple (block, tx, call)
def evmEnvBlock : EvmEnv -> EvmBlock := fun (env : EvmEnv) => env.0
def evmEnvTx : EvmEnv -> EvmTx := fun (env : EvmEnv) => env.1
def evmEnvCall : EvmEnv -> EvmCall := fun (env : EvmEnv) => env.2
def evmEnvWithCall : EvmEnv -> EvmCall -> EvmEnv := fun (env : EvmEnv) (call : EvmCall) => tuple (env.0, env.1, call)
def evmEnvEqual : EvmEnv -> EvmEnv -> Bool := fun (a : EvmEnv) (b : EvmEnv) => boolAnd (evmBlockEqual a.0 b.0) (boolAnd (evmTxEqual a.1 b.1) (evmCallEqual a.2 b.2))

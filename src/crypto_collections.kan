def seqBatchWorkerUniq : (prod (BatchDigest, WorkerId) -> prod (BatchDigest, WorkerId) -> Ordering) -> BatchWorkers -> BatchWorkers :=
  fun (compare : prod (BatchDigest, WorkerId) -> prod (BatchDigest, WorkerId) -> Ordering) (xs : BatchWorkers) => seqBatchWorkerUniqScan xs compare (valueNone (prod (BatchDigest, WorkerId))) batchWorkersNil
def seqBatchWorkerOps : ListOps (prod (BatchDigest, WorkerId)) BatchWorkers :=
  tuple (seqBatchWorkerEmpty, seqBatchWorkerCons, seqBatchWorkerReverse, seqBatchWorkerLength, seqBatchWorkerHead, seqBatchWorkerTail, seqBatchWorkerWrite, seqBatchWorkerSort, seqBatchWorkerUniq)
